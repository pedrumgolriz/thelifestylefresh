# Postgres — Railway injects this automatically when you attach a database
DATABASE_URL="postgresql://lifestyle:lifestyle@localhost:5432/lifestylefresh?schema=public"

# Public site URL (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Random 32+ character secret for admin / member sessions
AUTH_SECRET="replace-with-a-long-random-string"

# Seeded on first deploy (change immediately)
ADMIN_EMAIL="hello@thelifestylefresh.com"
ADMIN_PASSWORD="changeme-on-railway"

# How many active members the house will keep. Raise as you scale.
MEMBER_CAP="40"

# Stripe — create a $34.99 / month recurring Price (shown on the public house)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_ID="price_..."
